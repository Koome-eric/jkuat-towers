# Postgres connection string. Matches docker-compose.yml's defaults exactly —
# if you used `docker compose up -d`, this works with zero edits.
# Using Neon/Supabase/Railway instead? Paste their connection string here.
DATABASE_URL="postgresql://jkuat:jkuat_dev_pw@localhost:5432/jkuat_towers?schema=public"

# Clerk (vendor authentication) — from https://dashboard.clerk.com -> your app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/onboard"

# Public base URL, used to build the product links the WhatsApp assistant
# sends back to customers (e.g. https://shop.jkuattowers.com). Use your
# ngrok/tunnel URL while developing so links work on a real phone.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Business Cloud API (Meta) - fill in once you have a business number.
# WHATSAPP_VERIFY_TOKEN is a string you invent yourself and paste into the
# Meta webhook config; it just proves the verification request came from Meta.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="jkuat-towers-verify"

# OpenAI API key for the AI shopping assistant / vendor business brain
OPENAI_API_KEY=""
